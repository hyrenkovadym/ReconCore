APP_ENV=development
APP_NAME=ReconCore API
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

POSTGRES_DB=reconcore
POSTGRES_USER=reconcore
POSTGRES_PASSWORD=reconcore
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

MONGO_ROOT_USERNAME=reconcore
MONGO_ROOT_PASSWORD=reconcore
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB=reconcore_raw

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

RABBITMQ_DEFAULT_USER=reconcore
RABBITMQ_DEFAULT_PASS=reconcore
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672

CELERY_BROKER_URL=amqp://reconcore:reconcore@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=reconcore-dev-bucket

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

